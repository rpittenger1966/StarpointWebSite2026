@page
@model Pointstar.Site.Pages.ChemPoint.CPGraphsModel
@{
	Layout = "/Pages/Shared/_MainLayout.cshtml";
	ViewData["Title"] = "Title Here";
	ViewData["Caption"] = "ChemPoint Graphs";
	ViewData["Subcaption"] = "Data Visualization with ChemPoint Professional";
}

<h2>
	ChemPoint Professional is the only environmental database application
	with graphs built right into the program.
</h2>
<p>
	<b>ChemPoint Professional</b> features twelve difference
	types of highly customizable graphs.&nbsp; You have extensive control over
	graph axes, colors, fonts, scales, parameters, and units.&nbsp; Page layout
	options include margins, headers, footers, and multiple graphs per printed
	page.
</p>

