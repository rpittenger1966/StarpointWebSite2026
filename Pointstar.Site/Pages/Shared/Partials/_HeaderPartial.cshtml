@model Pointstar.Core.WebControls.BasePageModel
@{
}

<div class="header">
	<div class="AboveNav">


		<table cellpadding="0" cellspacing="0" width="100%">
			<tr>
				<td colspan="2" align="left">

					@if (Model.SignedIn)
					{
						<div class="TopNavLink">
							<a href="~/Members/SignOut">Sign Out</a>
							<asp:HyperLink ID="linkSignOut" runat="server" Text="Sign Out" NavigateUrl="~/Members/Signout.aspx" />

						</div>
					}
					else
					{

						<div class="TopNavLink">
							<a href="~/Members/SignIn">Sign In</a>
							<asp:HyperLink ID="linkSignin" runat="server" Text="Sign In" NavigateUrl="~/Members/Signin.aspx" Visible="false" />
						</div>
					}


				</td>
			</tr>

			<tr valign="top">
				<td>
					<h3>
						<a href="/">@ViewData["Caption"]</a>
					</h3>

				</td>
				<td>
					<div class="Testimonial">
						@Html.Raw(Model.Testimonial)
					</div>

					@if (Model.SignedIn)
					{
						<div class="LoggedInAs">
							@Model.LoggedInAs
						</div>
					}
					else
					{
						<div class="LoggedInAs">
							&nbsp;
						</div>
					}

				</td>

			</tr>
			<tr valign="top">
				<td colspan="2">
					<h2>
						@ViewData["Subcaption"]
					</h2>
				</td>
			</tr>

		</table>






	</div> <!-- End of above nav-->


	<div class="Nav">
		<div class="NavOrder">
			<div class="inner">
				<a href="/Order/OrderOnline">Order Online</a>
			</div>

			<ul>
				@switch (Model.Menu)
				{
					case MenuEnum.Aquifer:
						<li><a href="/Aquifer/">Aquifer Test Analysis</a></li>
						<li><a href="/Aquifer/InfiniteExtent">Infinite Extent</a></li>
						<li><a href="/Aquifer/SuperSlug">Super Slug</a></li>
						<li><a href="/Aquifer/StepMaster">StepMaster</a></li>
						break;
					case MenuEnum.ChemPoint:
						<li><a href="/ChemPoint/">ChemPoint</a></li>
						<li><a href="/ChemPoint/CPFeatures">ChemPointFeatures</a></li>
						<li><a href="/ChemPoint/Graphs">Graphs</a></li>
						<li><a href="/ChemPoint/Contouring">Contouring</a></li>
						break;
					case MenuEnum.ChemStat:
						<li><a href="/ChemStat/">ChemStat</a></li>
						<li><a href="/ChemStat/ChemStatFaq">ChemStat FAQ</a></li>
						break;
					default:
						<li><a href="/Starpoint/Products">Products</a></li>
						<li><a href="/Starpoint/Pricing">Prices</a></li>
						<li><a href="/Download/">Trial Versions</a></li>
						<li><a href="/Starpoint/Contact">Contact</a></li>
						break;
				}

				<asp:PlaceHolder ID="phNavigation" runat="server" />
			</ul>
		</div>
	</div>



</div>


<div class="clear"></div>
