@{
	Layout = "/Pages/Shared/_MainLayout.cshtml";
	ViewData["Title"] = "About Starpoint Software";
	ViewData["Caption"] = "About Starpoint Software";
	ViewData["Subcaption"] = "Software Applications for Science and Engineering";
